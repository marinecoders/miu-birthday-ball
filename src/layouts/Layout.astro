---
import codersLogo from "../../assets/Marine Coders Logo.png";
import { Image } from "astro:assets";
import { url } from "../lib/url.js";
import { EVENT } from "../lib/event.js";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = null } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="dark"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content={`Find your table at the ${EVENT.title}.`}
    />
    <meta
      name="theme-color"
      content="#0B0F17"
    />
    <meta
      name="robots"
      content="noindex"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={url("favicon.svg")}
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Rubik:wght@300;400;500;700&display=swap"
    />
    <title>{title ? `${title} · ` : ""}{EVENT.title}</title>
  </head>
  <body
    class="min-h-dvh flex flex-col text-slate-100 font-rubik antialiased selection:bg-gold selection:text-ink"
  >
    <main class="flex-1 w-full">
      <slot />
    </main>
    <footer class="py-8 px-4 pb-[max(2rem,env(safe-area-inset-bottom))]">
      <a
        href="https://marines.dev/"
        target="_blank"
        rel="noopener noreferrer"
        class="mx-auto flex w-fit items-center gap-3 rounded-full px-4 py-2 text-xs font-semibold tracking-[0.2em] text-slate-400 transition hover:text-slate-200 hover:bg-white/5"
      >
        <span>POWERED BY MARINE CODERS</span>
        <Image
          width={28}
          height={28}
          src={codersLogo}
          alt=""
        />
      </a>
    </footer>
  </body>
</html>
