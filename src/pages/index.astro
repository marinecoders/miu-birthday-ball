---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/marinecorps/Hero.astro";
import DropDown from "../components/react/Dropdown.jsx";
import TableSelection from "../components/svelte/TableSelection.svelte";
import miuLogo from "../../assets/Marine Innovation Unit - White.png";
import { Image } from "astro:assets";
import { url } from "../lib/url.js";
---

<Layout>
  <div
    class="curtain curtain-left"
    aria-hidden="true"
  >
  </div>
  <div
    class="curtain curtain-right"
    aria-hidden="true"
  >
  </div>

  <script>
    import { withKey } from "../lib/attendees.js";
    const program = document.getElementById("program-link");
    program.href = withKey(program.getAttribute("href"));
    // Once the curtains have opened, take them out of the page entirely.
    for (const curtain of document.querySelectorAll(".curtain")) {
      curtain.addEventListener("animationend", () => curtain.remove());
      setTimeout(() => curtain.remove(), 3000);
    }
  </script>

  <Hero content="Search for your name to find your table." />

  <section
    class="relative z-10 mx-auto mt-10 w-full max-w-lg px-5 rise"
    style="animation-delay: 150ms"
    aria-label="Find your table"
  >
    <div class="rounded-3xl border border-white/10 bg-ink-800/80 p-5 shadow-glow backdrop-blur-sm sm:p-7">
      <label
        for="guest-search"
        class="mb-3 block text-sm font-medium uppercase tracking-[0.2em] text-slate-400"
      >
        Your name
      </label>
      <DropDown client:only="react" />
    </div>
    <p class="mt-4 px-2 text-center text-sm leading-relaxed text-slate-400">
      Can't find your name? Try just your last name, or stop by the
      <span class="font-medium text-slate-200">check-in table at the entrance</span>
      and we'll get you to your seat.
    </p>
    <div class="mt-5 flex justify-center">
      <a
        id="program-link"
        href={url("info/")}
        class="inline-flex items-center gap-2 rounded-full border border-gold/30 px-4 py-2 text-sm font-medium text-gold-soft transition hover:border-gold hover:bg-gold/10"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm.75-13a.75.75 0 0 0-1.5 0v5c0 .2.08.39.22.53l3 3a.75.75 0 1 0 1.06-1.06l-2.78-2.78V5Z" clip-rule="evenodd" /></svg>
        Evening information
      </a>
    </div>
  </section>

  <section
    class="mx-auto mt-16 w-full max-w-4xl px-5"
    aria-labelledby="by-table"
  >
    <div class="divider">
      <h2
        id="by-table"
        class="shrink-0 text-xs font-semibold uppercase tracking-[0.3em] text-gold-soft"
      >
        Browse by table
      </h2>
    </div>
    <p class="mt-3 text-center text-sm text-slate-400">
      Tap a table to see who's sitting there.
    </p>
    <TableSelection client:only="svelte" />
  </section>

  <div class="mt-16 flex justify-center px-5">
    <Image
      src={miuLogo}
      alt="Marine Innovation Unit"
      width={220}
      class="h-auto w-44 opacity-70 sm:w-52"
    />
  </div>
</Layout>
