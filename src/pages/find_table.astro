---
import Layout from "../layouts/Layout.astro";
import TableNumber from "../components/react/TableNumber.jsx";
import Schedule from "../components/marinecorps/Schedule.astro";
import CommandantMessage from "../components/marinecorps/CommandantMessage.astro";

import { EVENT } from "../lib/event.js";
import { url } from "../lib/url.js";
import { BUTTON_SECONDARY } from "../lib/ui.js";
---

<Layout title="Your table">
  <script>
    import { celebrate } from "../lib/celebrate.js";
    celebrate(new URLSearchParams(window.location.search).get("name") || "");
  </script>

  <TableNumber client:only="react" />

  <div class="mt-16">
    <Schedule />
  </div>

  <CommandantMessage />

  <div class="mt-14 flex flex-col items-center justify-center gap-3 px-5 sm:flex-row">
    <a
      id="info-link"
      class={BUTTON_SECONDARY}
      href={url("info/")}
    >
      Evening information
    </a>
    <a
      id="back-to-search"
      class={BUTTON_SECONDARY}
      href={url()}
    >
      Back to search
    </a>
  </div>
  <script>
    import { withKey } from "../lib/attendees.js";
    for (const id of ["back-to-search", "info-link"]) {
      const link = document.getElementById(id);
      link.href = withKey(link.getAttribute("href"));
    }
  </script>
</Layout>
