---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/marinecorps/Hero.astro";
import miuLogo from "../../assets/Marine Innovation Unit - White.png";
import { Image } from "astro:assets";
import { EVENT } from "../lib/event.js";
---

<Layout title="Scan a QR code">
  <Hero
    title={`Welcome to the ${EVENT.title}`}
    padding="pt-16 sm:pt-24"
  />
  <div class="mx-auto mt-10 max-w-md px-5 rise" style="animation-delay: 150ms">
    <div class="rounded-3xl border border-white/10 bg-ink-800/70 p-6 text-center shadow-glow">
      <svg aria-hidden="true" class="mx-auto h-10 w-10 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" />
      </svg>
      <p class="mt-4 text-lg text-slate-200">
        Please scan any of the QR codes found throughout the venue.
      </p>
    </div>
  </div>
  <div class="mt-14 flex justify-center px-5">
    <Image
      src={miuLogo}
      alt="Marine Innovation Unit"
      width={220}
      class="h-auto w-44 opacity-70 sm:w-52"
    />
  </div>
</Layout>
