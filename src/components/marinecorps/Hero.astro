---
import { Image } from "astro:assets";
import ega from "../../../assets/EGA-White.png";
import RedButton from "../buttons/RedButton.astro";
import { EVENT } from "../../lib/event.js";

interface Props {
  title?: string;
  content?: string;
  link?: string;
  linkText?: string;
  padding?: string;
}

const {
  title = EVENT.title,
  content = null,
  link = null,
  linkText = null,
  padding = "pt-12 sm:pt-16",
} = Astro.props;
---

<header class:list={["mx-auto max-w-3xl px-5 text-center rise", padding]}>
  <Image
    src={ega}
    alt="Eagle, Globe, and Anchor"
    width={96}
    height={96}
    class="mx-auto h-20 w-auto opacity-95 drop-shadow-[0_4px_24px_rgba(255,199,44,0.25)] sm:h-24"
    loading="eager"
  />
  <p class="mt-6 text-xs font-semibold uppercase tracking-[0.35em] text-gold-soft">
    {EVENT.date}
  </p>
  <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight text-balance text-white sm:text-5xl md:text-6xl">
    {title}
  </h1>
  {
    content && (
      <p class="mx-auto mt-4 max-w-xl text-base text-slate-300 text-balance sm:text-lg">
        {content}
      </p>
    )
  }
  {
    link && (
      <div class="mt-8 flex justify-center">
        <RedButton
          href={link}
          text={linkText}
        />
      </div>
    )
  }
</header>
